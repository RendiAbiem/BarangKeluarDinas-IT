@model IEnumerable<BarangKeluarDinas.Models.RequestMaterial>

@{
    ViewData["Title"] = "Monitoring Pengajuan Material";
}

<div class="container-fluid mt-4 mb-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <strong>Berhasil!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="mb-0 fw-bold text-dark">Daftar Pengajuan Kebutuhan Material</h3>
            <p class="text-muted mb-0">Pusat pemantauan *request* barang baru dan restok dari tim SPOKE / IT.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4 shadow-sm">
            + Buat Pengajuan Baru
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold py-3">
            Tabel Antrean Request Logistik
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-light position-sticky top-0 shadow-sm">
                        <tr>
                            <th class="ps-4">TANGGAL</th>
                            <th>PEMOHON</th>
                            <th>KATEGORI</th>
                            <th>SPESIFIKASI BARANG</th>
                            <th class="text-center">KUANTITAS</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center pe-4">AKSI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted fw-bold small">
                                        @item.TanggalRequest.ToString("dd MMM yyyy")<br />
                                        <span class="font-monospace" style="font-size: 0.75rem;">@item.TanggalRequest.ToString("HH:mm")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark d-block">@item.NamaPemohon</span>
                                        <span class="badge bg-secondary bg-opacity-25 text-dark border small">@item.Departemen</span>
                                    </td>
                                    <td>
                                        @if (item.JenisRequest == "Barang Baru")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2">Barang Baru</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25 px-2">Barang Lama</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark d-block">@item.NamaBarang</span>
                                        @if (!string.IsNullOrEmpty(item.NoMaterial))
                                        {
                                            <span class="text-muted font-monospace small">No: @item.NoMaterial</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">Belum ada nomor</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bolder text-primary fs-6">
                                        @item.Jumlah <span class="text-muted fs-6">@item.Satuan</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">Menunggu</span>
                                        }
                                        else if (item.Status == "Disetujui")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm">Disetujui</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark fw-bold border-2 shadow-sm">Cek Detail</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted fst-italic py-5">
                                    Belum ada pengajuan material logistik saat ini.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>