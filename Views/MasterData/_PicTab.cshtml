@using BarangKeluarDinas.Models

<div class="row g-4">
    <div class="col-md-4">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3">
                <h6 class="m-0 fw-bolder text-success text-uppercase" style="font-size: 0.85rem;">Registrasi PIC Baru</h6>
            </div>
            <div class="card-body bg-light">
                <form asp-action="TambahPIC" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-1">Nama Lengkap</label>
                        <input name="NamaLengkap" class="form-control form-control-sm border-secondary shadow-none" placeholder="Nama teknisi / pekerja..." required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-1">Departemen</label>
                        <input name="Departemen" class="form-control form-control-sm border-secondary shadow-none" value="IT" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm py-2">SIMPAN PIC</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="m-0 fw-bolder text-dark text-uppercase" style="font-size: 0.85rem;">Daftar Personel IT</h6>
                <form asp-action="Index" method="get" class="d-flex gap-2 m-0" style="max-width: 300px; width: 100%;">
                    <div class="input-group input-group-sm shadow-sm">
                        <input type="text" name="searchPIC" class="form-control border-secondary shadow-none" placeholder="Cari Nama..." value="@ViewData["CurrentPICFilter"]" />
                        <button type="submit" class="btn btn-dark px-3 fw-bold">CARI</button>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover table-modern mb-0">
                        <thead class="table-light position-sticky top-0 shadow-sm">
                            <tr>
                                <th class="ps-4">NAMA LENGKAP PERSONEL</th>
                                <th>DEPARTEMEN</th>
                                <th class="text-center">STATUS</th>
                                <th class="text-center pe-4">AKSI</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ListPIC != null && ((List<MasterPIC>)ViewBag.ListPIC).Any())
                            {
                                foreach (var item in ViewBag.ListPIC)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bolder text-dark">@item.NamaLengkap</td>
                                        <td class="text-muted fw-semibold text-uppercase">@item.Departemen</td>
                                        <td class="text-center">
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-3">Active</span>
                                        </td>
                                        <td class="text-center pe-4">
                                            <div class="d-flex justify-content-center gap-1">
                                                <button type="button" class="btn btn-xs btn-outline-primary border-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalEditPic-@item.Id">Edit</button>

                                                <form asp-action="DeletePIC" method="post" class="m-0">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-xs btn-outline-danger border-2 shadow-sm" onclick="return confirm('Apakah Anda yakin ingin menghapus PIC @item.NamaLengkap secara permanen?');">Hapus</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>

                                    <div class="modal fade" id="modalEditPic-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow-lg" style="border-radius: 0.75rem; overflow: hidden;">
                                                <div class="modal-header bg-primary text-white border-0 py-3">
                                                    <h6 class="modal-title fw-bold text-uppercase" style="font-size: 0.85rem;">Edit Data PIC</h6>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="EditPIC" method="post">
                                                    <div class="modal-body bg-light p-4">
                                                        <input type="hidden" name="id" value="@item.Id" />

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-muted text-uppercase mb-1">Nama Lengkap</label>
                                                            <input type="text" name="namaLengkap" class="form-control fw-bold border-secondary shadow-none" value="@item.NamaLengkap" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-muted text-uppercase mb-1">Departemen</label>
                                                            <input type="text" name="departemen" class="form-control border-secondary shadow-none" value="@item.Departemen" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-white border-top p-3">
                                                        <button type="button" class="btn btn-light border fw-bold px-4" data-bs-dismiss="modal">Batal</button>
                                                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Simpan Perubahan</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center text-muted fst-italic py-5">Database PIC kosong.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>