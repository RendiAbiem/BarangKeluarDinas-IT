@{
    ViewData["Title"] = "Kelola Master Data & Inventori";
}

<style>
    .nav-tabs .nav-link { color: #6c757d; border: none; border-bottom: 3px solid transparent; transition: all 0.2s ease-in-out; font-weight: 600; padding: 0.75rem 1.25rem; }
    .nav-tabs .nav-link:hover { color: #495057; border-bottom: 3px solid #cbd3da; }
    .nav-tabs .nav-link.active { color: #0d6efd; background-color: transparent; border-bottom: 3px solid #0d6efd; }
    .table-modern thead th { font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 2px solid #dee2e6; color: #495057; text-transform: uppercase; }
    .table-modern tbody td { font-size: 0.85rem; vertical-align: middle; }
    .card-custom { border-radius: 0.5rem; border: 1px solid #e9ecef; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.03); }
    .btn-xs { padding: 0.2rem 0.5rem; font-size: 0.75rem; border-radius: 0.25rem; font-weight: bold; }
</style>

<div class="container-fluid mt-4 px-md-4 mb-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-5 border-success" role="alert">
            <strong class="text-success">BERHASIL!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 border-start border-5 border-danger" role="alert">
            <strong class="text-danger">GAGAL!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bolder mb-1" style="letter-spacing: -0.5px;">Panel Logistik & Master Data</h2>
            <p class="text-muted small mb-0">Manajemen inventori pusat, audit mutasi barang (in/out), dan pengaturan entitas sistem.</p>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4 border-bottom-0" id="masterDataTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active text-uppercase" style="font-size: 0.8rem;" id="material-tab" data-bs-toggle="tab" data-bs-target="#material" type="button" role="tab">Database Material</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-uppercase" style="font-size: 0.8rem;" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">History Log Barang</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-uppercase" style="font-size: 0.8rem;" id="pic-tab" data-bs-toggle="tab" data-bs-target="#pic" type="button" role="tab">Tim / Teknisi</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-uppercase" style="font-size: 0.8rem;" id="lokasi-tab" data-bs-toggle="tab" data-bs-target="#lokasi" type="button" role="tab">Lokasi Site</button>
        </li>
    </ul>

    <div class="tab-content" id="masterDataTabsContent">
        <div class="tab-pane fade show active" id="material" role="tabpanel">
            <partial name="_MaterialTab" />
        </div>
        <div class="tab-pane fade" id="history" role="tabpanel">
            <partial name="_HistoryTab" />
        </div>
        <div class="tab-pane fade" id="pic" role="tabpanel">
            <partial name="_PicTab" />
        </div>
        <div class="tab-pane fade" id="lokasi" role="tabpanel">
            <partial name="_LokasiTab" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_MasterDataScripts" />
}