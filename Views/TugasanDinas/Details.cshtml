@model BarangKeluarDinas.Models.TugasanDinas

@{
    ViewData["Title"] = "Laporan Detail Penugasan";
    var isPending = Model.SenaraiBarang != null && Model.SenaraiBarang.Any(i => i.Status == BarangKeluarDinas.Models.StatusAliranBarang.DibawaKeluar);
    // materialList tetap kita simpan di ViewBag karena dibutuhkan oleh partial tambah material
    var materialList = ViewBag.MaterialList as List<BarangKeluarDinas.Models.MasterMaterial>;
}

<div class="container mt-4 mb-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <strong>Berhasil!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <strong>Oops!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-dark fw-bold shadow-sm px-3">
                &larr; Kembali
            </a>
            <div>
                <h2 class="mb-0">Laporan Detail Rekapitulasi Tugas</h2>
                <p class="text-muted mb-0">Arsip dokumen logistik perjalanan dinas lapangan tim IT.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportWord" asp-route-id="@Model.Id" class="btn btn-primary fw-bold shadow-sm d-flex align-items-center gap-2">
                Unduh Dokumen Word
            </a>
            @if (isPending)
            {
                <span class="badge bg-danger p-3 fs-6 shadow-sm d-flex align-items-center">Status: Belum Selesai</span>
            }
            else
            {
                <span class="badge bg-success p-3 fs-6 shadow-sm d-flex align-items-center">Status: Selesai</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white fw-bold">Informasi Administrasi Tugas Dinas</div>
                <div class="card-body bg-white rounded-bottom">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Nama PIC</small>
                            <span class="fw-bold text-dark">@Model.PIC</span>
                        </div>
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Lokasi Site Tujuan</small>
                            <span class="fw-bold text-dark">@Model.LokasiDinas</span>
                        </div>
                        <div class="col-12 col-md-4">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Rentang Waktu</small>
                            <span class="fw-bold text-dark">@Model.TanggalDari.ToString("dd MMM yyyy") - @Model.TanggalKe.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="col-12 border-top pt-3 mt-3">
                            <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.75rem;">Deskripsi Perintah Tugas (Jobdesk)</small>
                            <p class="text-dark bg-light p-3 rounded border small" style="white-space: pre-line;">@Model.Jobdesk</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center py-2">
                    <span>Daftar Material Logistik Yang Dikeluarkan</span>
                    <button type="button" class="btn btn-sm btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalTambahMaterial">
                        + Tambah Material
                    </button>
                </div>
                <div class="card-body bg-white p-0 rounded-bottom">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-secondary">
                                <tr>
                                    <th class="ps-3">Spesifikasi Material</th>
                                    <th class="text-center">Jumlah Bawa</th>
                                    <th>Barcode / S/N</th>
                                    <th>Status Aliran</th>
                                    <th class="text-center">Opsi Laporan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SenaraiBarang != null && Model.SenaraiBarang.Any())
                                {
                                    foreach (var barang in Model.SenaraiBarang)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <span class="fw-bold text-dark">@barang.NamaUnit</span>
                                                <div class="small text-muted font-monospace">@barang.NoMaterial</div>
                                                @if(!string.IsNullOrEmpty(barang.Keterangan)) {
                                                    <div class="mt-1 small text-secondary fst-italic">Ket: @barang.Keterangan</div>
                                                }
                                            </td>
                                            <td class="text-center fw-bold text-primary">@barang.JumlahBawa @barang.STN</td>
                                            <td class="font-monospace small">@(string.IsNullOrEmpty(barang.Barcode) ? "-" : barang.Barcode)</td>
                                            <td>
                                                @if(barang.Status == BarangKeluarDinas.Models.StatusAliranBarang.DibawaKeluar) {
                                                    <span class="badge bg-info text-dark">Dibawa (Pending)</span>
                                                } else if (barang.Status == BarangKeluarDinas.Models.StatusAliranBarang.TerpakaiKategoriSRM) {
                                                    <span class="badge bg-danger">Terpakai (Lapangan)</span>
                                                } else {
                                                    <span class="badge bg-success">Kembali (Gudang)</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex gap-1 justify-content-center">
                                                    @if(barang.Status == BarangKeluarDinas.Models.StatusAliranBarang.DibawaKeluar) {
                                                        <form asp-controller="ItemBarangKeluar" asp-action="QuickReturn" asp-route-id="@barang.Id" method="post" onsubmit="return confirm('Proses penarikan balik material utuh ke gudang?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-success py-1">Tarik</button>
                                                        </form>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark py-1 btn-buka-modal" 
                                                            data-bs-toggle="modal" data-bs-target="#modalLaporanMaterial"
                                                            data-id="@barang.Id"
                                                            data-tugasanid="@barang.TugasanDinasId"
                                                            data-nomaterial="@barang.NoMaterial"
                                                            data-namaunit="@barang.NamaUnit"
                                                            data-kategori="@barang.KategoriAsset"
                                                            data-stn="@barang.STN"
                                                            data-barcode="@(barang.Barcode ?? "")"
                                                            data-jumlahbawa="@barang.JumlahBawa"
                                                            data-status="@barang.Status"
                                                            data-srm="@(barang.SRM ?? "")"
                                                            data-keterangan="@(barang.Keterangan ?? "")"
                                                            data-tanggaldipakai="@(barang.TanggalDipakai?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                                            data-tanggaldikembalikan="@(barang.TanggalDikembalikan?.ToString("yyyy-MM-ddTHH:mm") ?? "")">
                                                        Isi Laporan
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center text-muted fst-italic py-4">Tugas dinas ini diproses tanpa membawa material dari gudang IT.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-secondary text-white fw-bold">Berkas Lampiran Persetujuan</div>
                <div class="card-body bg-light">
                    @if (!string.IsNullOrEmpty(Model.PathDokumenBukti))
                    {
                        <div class="p-3 bg-white rounded border border-success mb-3 text-center">
                            <span class="fw-bold text-success d-block mb-2">Dokumen Terarsip</span>
                            <a href="@Url.Content($"~/uploads/bukti/{Model.PathDokumenBukti}")" target="_blank" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm">Buka Lampiran</a>
                        </div>
                    }
                    <form asp-action="UploadBukti" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2">
                            <input type="file" name="file" class="form-control form-control-sm border-secondary" accept=".pdf,.jpg,.jpeg,.png" required />
                        </div>
                        <button type="submit" class="btn btn-sm btn-dark w-100 fw-bold">Unggah Dokumen Baru</button>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body bg-white text-center">
                    <p class="small text-muted mb-3">Jika seluruh rekapitulasi pelaporan material bawaan di sebelah kiri telah selesai diproses, Anda dapat mengonfirmasi penutupan tugas ini.</p>
                    @if (isPending)
                    {
                        <form asp-action="SelesaikanTugas" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menyatakan tugas dinas ini selesai sepenuhnya?');">
                            <button type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow-sm">Konfirmasi Selesai Tugas</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-success w-100 fw-bold py-2" disabled>Tugas Selesai Terverifikasi</button>
                    }
                    
                    <a asp-action="Index" class="btn btn-dark w-100 fw-bold py-2 mt-3 shadow-sm">&larr; Kembali ke Daftar Utama</a>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_ModalLaporanMaterial" />
<partial name="_ModalTambahMaterial" model="Model" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // ====================================================
            // LOGIKA MODAL 1: PENGELOLAAN STATUS BARANG LAPANGAN
            // ====================================================
            const modalLaporanMaterial = document.getElementById('modalLaporanMaterial');
            
            // Elemen Panel Waktu Logistik Aktual
            const modalTanggalDipakai = document.getElementById('modalTanggalDipakai');
            const modalTanggalKembali = document.getElementById('modalTanggalKembali');
            const divTanggal = document.getElementById('modalDivTanggal');
            const wrapTanggalPakai = document.getElementById('wrapTanggalPakai');
            const wrapTanggalKembali = document.getElementById('wrapTanggalKembali');
            
            let currentMaxBawa = 0;

            modalLaporanMaterial.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const tugasanId = button.getAttribute('data-tugasanid');
                const noMaterial = button.getAttribute('data-nomaterial');
                const namaUnit = button.getAttribute('data-namaunit');
                const kategori = button.getAttribute('data-kategori');
                const stn = button.getAttribute('data-stn');
                const barcode = button.getAttribute('data-barcode');
                const jumlahBawa = parseInt(button.getAttribute('data-jumlahbawa')) || 0;
                const status = button.getAttribute('data-status');
                const srm = button.getAttribute('data-srm');
                const keterangan = button.getAttribute('data-keterangan');
                const tglPakai = button.getAttribute('data-tanggaldipakai');
                const tglKembali = button.getAttribute('data-tanggaldikembalikan');

                currentMaxBawa = jumlahBawa;

                document.getElementById('modalId').value = id;
                document.getElementById('modalTugasanId').value = tugasanId;
                document.getElementById('modalNoMaterial').value = noMaterial;
                document.getElementById('modalNamaUnitValue').value = namaUnit;
                document.getElementById('modalKategoriAsset').value = kategori;
                document.getElementById('modalSTN').value = stn;
                document.getElementById('modalBarcodeValue').value = barcode;
                document.getElementById('modalJumlahBawaValue').value = jumlahBawa;

                document.getElementById('dispNamaUnit').innerText = namaUnit;
                document.getElementById('dispNoMaterial').innerText = noMaterial;
                document.getElementById('dispJumlahBawa').innerText = jumlahBawa;
                document.getElementById('dispSTN').innerText = stn;
                document.getElementById('dispSTN2').innerText = stn;
                document.getElementById('dispBarcode').innerText = barcode === "" ? "Tidak Ada S/N" : barcode;

                document.getElementById('modalSRM').value = srm;
                document.getElementById('modalKeterangan').value = keterangan;
                
                // Isi Value Input Waktu
                if (modalTanggalDipakai) modalTanggalDipakai.value = tglPakai;
                if (modalTanggalKembali) modalTanggalKembali.value = tglKembali;

                let radioToSelect = document.querySelector(`input[name="Status"][value="${status}"]`);
                if (radioToSelect) { radioToSelect.checked = true; }

                document.getElementById('modalInputSisaKembali').value = 0;
                document.getElementById('modalSplitWarning').innerText = "";

                document.querySelectorAll('.btn-quick-tag').forEach(tag => {
                    tag.classList.remove('btn-info', 'btn-danger', 'btn-warning', 'btn-secondary', 'text-white');
                    if(tag.innerText.includes("Normal")) tag.classList.add('btn-outline-info');
                    if(tag.innerText.includes("Rusak")) tag.classList.add('btn-outline-danger');
                    if(tag.innerText.includes("Spare")) tag.classList.add('btn-outline-warning');
                    if(tag.innerText.includes("Salah")) tag.classList.add('btn-outline-secondary');
                });

                toggleSections();
            });

            const divDetailPemakaian = document.getElementById('modalDivDetailPemakaian');
            const wrapperAutoSplit = document.getElementById('modalWrapperAutoSplit');
            const inputSisaKembali = document.getElementById('modalInputSisaKembali');
            const splitWarning = document.getElementById('modalSplitWarning');
            const inputKeterangan = document.getElementById('modalKeterangan');
            const quickTags = document.querySelectorAll('.btn-quick-tag');
            const statusRadios = document.querySelectorAll('.modal-status-radio');

            function toggleSections() {
                const checkedRadio = document.querySelector('input[name="Status"]:checked');
                const statusVal = checkedRadio ? checkedRadio.value : '';
                let sisa = parseInt(inputSisaKembali.value) || 0;
                
                if (statusVal === 'TerpakaiKategoriSRM') {
                    divDetailPemakaian.style.display = 'block';
                    if (currentMaxBawa > 1) wrapperAutoSplit.style.display = 'block';
                    
                    if (divTanggal) divTanggal.style.display = 'block';
                    if (wrapTanggalPakai) wrapTanggalPakai.style.display = 'block';
                    if (wrapTanggalKembali) wrapTanggalKembali.style.display = sisa > 0 ? 'block' : 'none';

                } else if (statusVal === 'KembaliGudangIT') {
                    divDetailPemakaian.style.display = 'none';
                    wrapperAutoSplit.style.display = 'none';
                    inputSisaKembali.value = 0; 
                    splitWarning.innerText = "";

                    if (divTanggal) divTanggal.style.display = 'block';
                    if (wrapTanggalPakai) wrapTanggalPakai.style.display = 'none';
                    if (wrapTanggalKembali) wrapTanggalKembali.style.display = 'block';

                } else {
                    // Status Pending
                    divDetailPemakaian.style.display = 'none';
                    wrapperAutoSplit.style.display = 'none';
                    inputSisaKembali.value = 0; 
                    splitWarning.innerText = "";
                    
                    if (divTanggal) divTanggal.style.display = 'none';
                }
            }

            statusRadios.forEach(radio => { radio.addEventListener('change', toggleSections); });

            inputSisaKembali.addEventListener('input', function() {
                let sisa = parseInt(this.value) || 0;
                if (sisa < 0) this.value = 0;
                if (sisa >= currentMaxBawa) {
                    splitWarning.innerText = "Sisa kembali tidak boleh menyamai kuantitas bawaan.";
                    this.value = currentMaxBawa - 1; 
                } else {
                    splitWarning.innerText = ""; 
                }
                toggleSections(); // Panggil ulang untuk memunculkan kolom Waktu Kembali jika ada sisa
            });

            quickTags.forEach(tag => {
                tag.addEventListener('click', function() {
                    const tagText = this.innerText;
                    const currentText = inputKeterangan.value.trim();
                    if (!currentText.includes(tagText)) {
                        inputKeterangan.value = currentText === "" ? tagText : currentText + ", " + tagText;
                    }
                    this.classList.replace('btn-outline-info', 'btn-info');
                    this.classList.replace('btn-outline-danger', 'btn-danger');
                    this.classList.replace('btn-outline-warning', 'btn-warning');
                    this.classList.replace('btn-outline-secondary', 'btn-secondary');
                    this.classList.add('text-white');
                });
            });


            // ====================================================
            // LOGIKA MODAL 2: SCANNER POS KASIR TAMBAH BARANG BARU
            // ====================================================
            let keranjangTambahan = [];
            const selectMaterial = document.getElementById('addSelectMaterial');
            const manualQty = document.getElementById('addManualQty');
            const barcodeContainer = document.getElementById('addBarcodeInputsContainer');
            const btnTambahItem = document.getElementById('addBtnTambahItem');
            const cartBody = document.getElementById('addCartBody');
            const hiddenJson = document.getElementById('addHiddenItemsJson');
            const formTambah = document.getElementById('formTambahMaterialUtama');

            function renderBarcodeInputs() {
                let qty = parseInt(manualQty.value) || 1;
                if (qty < 1) { qty = 1; manualQty.value = 1; }
                
                let currentInputs = document.querySelectorAll('.add-barcode-input');
                let savedValues = [];
                currentInputs.forEach(inp => savedValues.push(inp.value));

                barcodeContainer.innerHTML = '';
                for (let i = 0; i < qty; i++) {
                    let val = savedValues[i] || '';
                    let html = `<input type="text" class="form-control font-monospace border-danger mb-2 add-barcode-input" placeholder="Scan barcode fisik ke-${i+1}..." value="${val}" />`;
                    barcodeContainer.insertAdjacentHTML('beforeend', html);
                }

                let newInputs = document.querySelectorAll('.add-barcode-input');
                newInputs.forEach((inp, idx) => {
                    inp.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            if (idx < newInputs.length - 1) newInputs[idx + 1].focus();
                            else prosesMasukKeranjang();
                        }
                    });
                });
            }

            manualQty.addEventListener('input', renderBarcodeInputs);
            renderBarcodeInputs();

            function hitungQtyDiKeranjang(noMaterial) {
                return keranjangTambahan.filter(i => i.NoMaterial === noMaterial).reduce((s, i) => s + i.JumlahBawa, 0);
            }

            function renderKeranjangTambahan() {
                cartBody.innerHTML = '';
                if (keranjangTambahan.length === 0) {
                    cartBody.innerHTML = `<tr><td colspan="4" class="text-center text-muted fst-italic py-3">Belum ada barang tambahan di keranjang.</td></tr>`;
                    return;
                }
                keranjangTambahan.forEach((item, index) => {
                    let row = `
                        <tr>
                            <td class="small fw-bold">${item.NamaUnit}<br><span class="text-muted font-monospace" style="font-size:0.75rem;">${item.NoMaterial}</span></td>
                            <td class="text-center fw-bold text-primary">${item.JumlahBawa} ${item.STN}</td>
                            <td class="font-monospace small">${item.Barcode || '-'}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-link text-danger btn-hapus-add" data-index="${index}">Hapus</button>
                            </td>
                        </tr>`;
                    cartBody.insertAdjacentHTML('beforeend', row);
                });

                document.querySelectorAll('.btn-hapus-add').forEach(btn => {
                    btn.addEventListener('click', function() {
                        let idx = this.getAttribute('data-index');
                        keranjangTambahan.splice(idx, 1);
                        renderKeranjangTambahan();
                    });
                });
            }

            function prosesMasukKeranjang() {
                let matVal = selectMaterial.value.trim();
                let option = document.querySelector(`#addMaterialDatalist option[value="${matVal}"]`);
                if (!option) {
                    alert("Silakan tentukan material utama dari datalist.");
                    selectMaterial.focus();
                    return;
                }

                let qtyInput = parseInt(manualQty.value) || 1;
                let maxStok = parseInt(option.getAttribute('data-stok')) || 0;
                let qtySekarang = hitungQtyDiKeranjang(matVal);

                if (qtySekarang + qtyInput > maxStok) {
                    alert(`Gagal! Total request melampaui sisa stok gudang IT.\nSisa Stok: ${maxStok}`);
                    return;
                }

                let inputs = document.querySelectorAll('.add-barcode-input');
                let blankCount = 0;

                inputs.forEach(inp => {
                    let bc = inp.value.trim();
                    if (bc !== "") {
                        let duplicate = keranjangTambahan.some(i => i.Barcode === bc);
                        if (duplicate) alert(`S/N "${bc}" ganda di keranjang sementara.`);
                        else {
                            keranjangTambahan.push({
                                NoMaterial: matVal,
                                NamaUnit: option.getAttribute('data-nama'),
                                KategoriAsset: option.getAttribute('data-kategori'),
                                JumlahBawa: 1,
                                STN: option.getAttribute('data-stn'),
                                Barcode: bc
                            });
                        }
                    } else {
                        blankCount++;
                    }
                });

                if (blankCount > 0) {
                    let exist = keranjangTambahan.find(i => i.NoMaterial === matVal && !i.Barcode);
                    if (exist) exist.JumlahBawa += blankCount;
                    else {
                        keranjangTambahan.push({
                            NoMaterial: matVal,
                            NamaUnit: option.getAttribute('data-nama'),
                            KategoriAsset: option.getAttribute('data-kategori'),
                            JumlahBawa: blankCount,
                            STN: option.getAttribute('data-stn'),
                            Barcode: null
                        });
                    }
                }

                selectMaterial.value = '';
                manualQty.value = '1';
                renderBarcodeInputs();
                renderKeranjangTambahan();
                selectMaterial.focus();
            }

            btnTambahItem.addEventListener('click', prosesMasukKeranjang);

            formTambah.addEventListener('submit', function(e) {
                if (keranjangTambahan.length === 0) {
                    e.preventDefault();
                    alert("Keranjang tambahan Anda masih kosong.");
                    return;
                }
                hiddenJson.value = JSON.stringify(keranjangTambahan);
            });

        });
    </script>
}