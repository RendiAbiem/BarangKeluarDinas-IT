@model BarangKeluarDinas.Models.TugasanDinas

@{
    Layout = null; // Bebas dari navbar utama agar fokus pada kertas laporan
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <title>Preview Laporan - @Model.PIC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #e4e6e9;
            font-family: 'Arial', sans-serif;
            font-size: 10pt;
            color: #000000;
        }

        /* 1. MENGHILANGKAN HEADER & FOOTER BROWSER */
        @@page {
            size: A4 portrait;
            margin: 0mm; 
        }
        
        /* 2. Simulasi Kertas A4 Portrait di Layar (Web) */
        .paper-sheet {
            background: #ffffff;
            width: 210mm;
            min-height: 297mm;
            padding: 20mm;
            margin: 25px auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            border-radius: 2px;
            color: #000000;
            line-height: 1.3;
        }

        .table-info { width: 100%; border: none; margin-bottom: 15px; color: #000; }
        .table-info td { padding: 3px; vertical-align: top; }
        .col-label { width: 22%; font-weight: bold; }
        .col-titik { width: 2%; text-align: center; }
        
        .table-data { width: 100%; border-collapse: collapse; margin-top: 10px; color: #000; }
        .table-data th, .table-data td { border: 1px solid #000000; padding: 8px 6px; }
        .table-data th { background-color: #f2f2f2; font-weight: bold; text-align: center; }
        
        /* 3. Aturan khusus saat tombol Print ditekan */
        @@media print {
            body { background-color: #ffffff; }
            .no-print { display: none !important; }
            .paper-sheet {
                margin: 0;
                box-shadow: none;
                padding: 15mm; 
                width: 100%;
                min-height: auto;
            }
        }
    </style>
</head>
<body>

    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-dark fw-bold px-4 shadow-sm">Cetak Laporan / Simpan PDF</button>
        <button onclick="window.close()" class="btn btn-outline-secondary fw-bold px-3 ms-2">Tutup Preview</button>
    </div>

    <div class="paper-sheet">
        <h3 class="text-center fw-bold mb-1" style="font-size: 14pt;">LAPORAN PENUGASAN DINAS & PENGELUARAN BARANG</h3>
        <h5 class="text-center mb-3" style="font-size: 11pt; font-weight: normal; color: #333;">Departemen IT Infrastruktur</h5>
        <hr style="border: 1px solid #000000; margin-bottom: 20px;" />

        <table class="table-info">
            <tr>
                <td class="col-label">Nama PIC / Teknisi</td>
                <td class="col-titik">:</td>
                <td class="fw-bold">@Model.PIC</td>
            </tr>
            <tr>
                <td class="col-label">Lokasi Tujuan</td>
                <td class="col-titik">:</td>
                <td>@Model.LokasiDinas</td>
            </tr>
            <tr>
                <td class="col-label">Tanggal Penugasan</td>
                <td class="col-titik">:</td>
                <td>@Model.TanggalDari.ToString("dd MMMM yyyy") - @Model.TanggalKe.ToString("dd MMMM yyyy")</td>
            </tr>
            <tr>
                <td class="col-label">Deskripsi Pekerjaan</td>
                <td class="col-titik">:</td>
                <td style="white-space: pre-line;">@Model.Jobdesk</td>
            </tr>
        </table>

        <p class="fw-bold mb-1" style="margin-top: 15px;">Rincian Material Logistik:</p>

        <table class="table-data">
            <thead>
                <tr>
                    <th style="width: 5%;">No</th>
                    <th style="width: 35%;">Spesifikasi Material</th>
                    <th style="width: 10%;">Qty</th>
                    <th style="width: 23%;">Barcode / Serial Number (S/N)</th>
                    <th style="width: 29%;">Dipakai? (Ceklis Manual)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SenaraiBarang != null && Model.SenaraiBarang.Any())
                {
                    int no = 1;
                    foreach (var barang in Model.SenaraiBarang)
                    {
                        <tr>
                            <td class="text-center align-middle">@no</td>
                            <td class="align-middle">
                                <span class="fw-bold">@barang.NamaUnit</span><br />
                                <span style="font-size: 8pt; color: #444;">No Mat: @barang.NoMaterial</span>
                            </td>
                            <td class="text-center align-middle fw-bold">@barang.JumlahBawa @barang.STN</td>
                            <td class="text-center align-middle font-monospace" style="font-size: 9pt;">
                                @(string.IsNullOrEmpty(barang.Barcode) ? "-" : barang.Barcode)
                            </td>
                            <td class="text-center align-middle font-monospace" style="font-size: 9.5pt; letter-spacing: 1px;">
                                [ &nbsp; ] YA &nbsp;&nbsp;&nbsp;&nbsp; [ &nbsp; ] TIDAK
                            </td>
                        </tr>
                        no++;
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-3">Tidak ada material yang dikeluarkan untuk tugas ini.</td></tr>
                }
            </tbody>
        </table>

        <div class="mt-3 p-2 rounded small" style="border: 1px solid #000;">
            <strong>Catatan Tambahan Lapangan / S/N Unit Lama yang Ditarik:</strong>
            <div style="height: 40px;"></div>
        </div>

        <div class="mt-3 p-3 rounded" style="border: 1px solid #000; font-size: 8.5pt; line-height: 1.4;">
            <p class="mb-1 fw-bold" style="font-size: 9pt; color: #000;">PENTING - PERNYATAAN TANGGUNG JAWAB PIC / TEKNISI:</p>
            <ol class="mb-0 ps-3" style="color: #000;">
                <li>Seluruh material logistik yang dibawa menjadi tanggung jawab penuh PIC selama masa penugasan. Apabila terjadi kerusakan atau kehilangan material akibat kelalaian di lapangan, maka PIC bersedia bertanggung jawab sepenuhnya sesuai dengan regulasi internal perusahaan.</li>
                <li>Material bawaan yang <strong>tidak digunakan atau tidak terpasang</strong> di lokasi site tujuan, <strong>WAJIB dibawa kembali</strong> dan diserahkan langsung ke pihak Gudang IT dalam kondisi utuh segera setelah masa penugasan berakhir.</li>
            </ol>
        </div>

        <table class="table-info" style="width: 100%; text-align: center; margin-top: 35px;">
            <tr>
                <td style="width: 50%;">
                    Mengetahui,<br /><br /><br /><br />
                    (_______________________)<br /> 
                    <strong>Admin Gudang IT</strong>
                </td>
                <td style="width: 50%;">
                    Diterima & Dikerjakan Oleh,<br /><br /><br /><br />
                    (_______________________)<br />
                    <strong>@Model.PIC</strong>
                </td>
            </tr>
        </table>
    </div>

</body>
</html>