<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistem Gudang IT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BarangKeluarDinas.styles.css" asp-append-version="true" />
    <style>
        .sidebar-link {
            transition: all 0.2s ease-in-out;
            border-radius: 6px;
        }
        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: #ffffff !important;
            transform: translateX(5px);
        }
    </style>
</head>
<body class="bg-light" style="margin-bottom: 0 !important;">
    <div class="d-flex" style="min-height: 100vh; overflow: hidden;">
        
        <div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark shadow" style="width: 260px;">
            <a asp-controller="TugasanDinas" asp-action="Index" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none px-2">
                <span class="fs-5 fw-bold tracking-wide">Sistem Gudang IT</span>
            </a>
            <hr class="text-secondary">
            
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a asp-controller="TugasanDinas" asp-action="Index" class="nav-link text-light sidebar-link px-3 py-2 fw-semibold">
                        Tugasan Dinas
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="MasterData" asp-action="Index" class="nav-link text-light sidebar-link px-3 py-2 fw-semibold">
                        Master Data
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="" asp-action="Index" class="nav-link text-light sidebar-link px-3 py-2 fw-semibold">
                        
                    </a>
                </li>
            </ul>
            
            <hr class="text-secondary">
            <div class="px-3" style="font-size: 0.8rem; color: #adb5bd;">
                <p class="mb-0 fw-bold"></p>
                <p class="mb-0">&copy; 2026</p>
            </div>
        </div>

        <div class="d-flex flex-column flex-grow-1" style="height: 100vh; overflow-y: auto;">
            
            <main role="main" class="flex-grow-1 p-4">
                <div class="bg-white rounded shadow-sm p-4 border" style="min-height: 85vh;">
                    @RenderBody()
                </div>
            </main>
            
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>